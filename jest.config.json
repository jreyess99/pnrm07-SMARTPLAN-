{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "testMatch": ["**/server/**/*.test.ts"],
  "collectCoverage": true,
  "collectCoverageFrom": ["server/**/*.ts", "!server/**/*.test.ts"],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  }
}
